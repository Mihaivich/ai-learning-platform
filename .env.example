# Gemini API (server-side only, never expose to the browser).
# Free-tier limits are per model, so a rate-limited first model hands over to the
# fallback; when both are unavailable the keyword grader takes over.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional: generating new projects is rare, so it starts with a stronger model.
GEMINI_GENERATION_MODEL=gemini-3.5-flash

# Supabase. Sign-in and saved project runs need all three.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: saves project runs after the signed-in user is checked.
# Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
